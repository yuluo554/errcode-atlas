# ============================================================
# 11-1-errcode-atlas · .gitignore
# Python 标准模板 + 本项目特有排除项
#   · data/catalog/   —— 编目源必须入库（这是本项目的底座）
#   · _private/       —— 本地核对材料
#   · .errcode-atlas/ —— 工具自身缓存
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 虚拟环境
.venv/
venv/
ENV/
env/
.python-version

# 测试与覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ---------- 本项目 ----------
_private/
.errcode-atlas/
tmp/
*.tmp
# 头文件原文的本地暂存（入库的是抽取后的 YAML，不是 .h 原文件）
_headers/
# 工具链的本机会话状态（本地钩子写出来的，不是仓库内容）
# 注意：`.gitignore` 声明了它，脱敏门的 SKIP_DIRS 就必须有对应项 ——
# 否则本地不红、干净检出/CI 里目录一旦被建出来就红（"扫描面 = 仓库内容"那条纪律）。
.mimosa/
# 发布产物的本地副本（M6）。**必须忽略**：`errcode-atlas-*.zip` 是 2.6 MB 的二进制，
# 它是 tag 树的派生件、已在 GitHub Release 上；入库等于把同一份内容存三遍
# （源树 + tag 树 + 附件），且 `git add -A` 会把 `gh release download` 的回下载件一起吞进来。
# 脱敏门的 SKIP_DIRS 里早有这一项 —— 那条对齐纪律是单向的（gitignore -> 门），
# 所以本目录先前只在门里、不在 gitignore 里，**这个缺口正是 M6 实测踩到的**。
dist-release/
# 打包产物的通用形态（`python -m build` 等）
*.whl

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- 例外：以下必须入库 ----------
!data/catalog/*.yaml
!data/README.md
!data/gaps.md
!plan/*.md
!fixtures/**/INPUT.md
!fixtures/**/expected.json
!docs/**/*.md
!docs/demo/*.gif